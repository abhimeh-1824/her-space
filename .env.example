# ==============================================================================
# HER-SPACE / HostelGuard — Environment Configuration Template
# Copy this file to .env.local or .env and fill in your values
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Client & Firestore Enterprise Configuration (Exposed to Browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:xxxxxx:web:xxxxxx"
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-hostelguardhoste-xxxxxx"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1555908782"
NEXT_PUBLIC_FIREBASE_OAUTH_CLIENT_ID="xxxx.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# Server-side Firebase Configuration (For API routes and node scripts)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_APP_ID="1:xxxxxx:web:xxxxxx"
FIREBASE_API_KEY="AIzaSy..."
FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-hostelguardhoste-xxxxxx"
FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="1555908782"
FIREBASE_OAUTH_CLIENT_ID="xxxx.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# Super Admin & Authorization Settings (RBAC & Anti-Tamper)
# ------------------------------------------------------------------------------
# Whitelisted Super Admin emails for anti-tamper role verification (comma-separated)
NEXT_PUBLIC_ADMIN_EMAILS="admin@example.com,proctor@example.com"
ADMIN_EMAILS="admin@example.com,proctor@example.com"

# Bootstrapped Primary Super Admin Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
ADMIN_NAME="Super Administrator"

# ------------------------------------------------------------------------------
# Security Secrets & Cron Automation
# ------------------------------------------------------------------------------
# Bearer secret for Cloudflare Worker Cron endpoint (/api/scheduler/cron)
CRON_SECRET="hostelguard_cf_worker_cron_sec_89b21"

# Gemini AI API Key (Required for AI Studio / automated summary if enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
